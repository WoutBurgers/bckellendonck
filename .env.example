# Frontend settings (copy to .env.local for local development).

# Production build on Netlify: the URL of the backend (e.g. https://bckellendonck-api.up.railway.app).
# The build then proxies /api/* to the backend, so the site and API share one domain.
BACKEND_URL=

# Only when the API is NOT proxied and runs on another domain (also set CORS_ORIGINS and
# COOKIE_SAMESITE=none on the server). Leave empty in the recommended setup.
VITE_API_URL=

# BC Kellendonck API – environment variables.
# Locally: copy to server/.env. In production: set these in Railway (Variables).
# Never commit real values.

NODE_ENV=production
PORT=3001

# Hash of the admin password. Create with: npm --prefix server run hash-secret
ADMIN_PASSWORD_HASH=

# Optional starting PIN for the members list (hash, also from hash-secret).
# Normally the PIN is set in the dashboard; a PIN set there takes precedence.
MEMBERS_PIN_HASH=

# --- Storage -------------------------------------------------------------
# s3    = S3-compatible bucket (recommended: Railway Bucket, Cloudflare R2, AWS S3)
# local = folder on disk; ONLY persistent on Railway when DATA_DIR is on a mounted Volume
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some other providers
S3_FORCE_PATH_STYLE=false

# For STORAGE_DRIVER=local
DATA_DIR=./data

# --- Network -------------------------------------------------------------
# Proxies in front of the API: Railway = 1.
TRUST_PROXY=1
# Folder with the built website. Default: ../dist (the output of npm run build in the repo root).
STATIC_DIR=
# Only needed when the website is hosted elsewhere and calls the API on another domain.
# Then also set COOKIE_SAMESITE=none.
CORS_ORIGINS=
COOKIE_SAMESITE=lax

# --- Limits and sessions --------------------------------------------------
MAX_UPLOAD_MB=15
MAX_MEMBERS_FILE_MB=2
ADMIN_SESSION_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12
MEMBER_SESSION_MINUTES=30
MEMBER_SESSION_MAX_HOURS=8

# --- Optional: e-mail notification for absence messages (resend.com) ------
RESEND_API_KEY=
AFMELDEN_EMAIL_TO=
AFMELDEN_EMAIL_FROM=
